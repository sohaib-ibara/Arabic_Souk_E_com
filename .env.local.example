# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your values.
# The storefront runs WITHOUT these (it falls back to the bundled sample
# catalogue), but set them to serve the catalogue from your Supabase project.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service-role key (Project Settings → API → service_role). Used SERVER-SIDE
# ONLY to record checkout demand into demand_signals (bypasses RLS). Keep it
# secret: never prefix with NEXT_PUBLIC_, never commit a real value. Without it,
# demand recording simply no-ops and the storefront still works.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Absolute site URL — used for canonical links, sitemap.xml and Open Graph tags.
# Use your production domain when deploying (e.g. https://arabicsouk.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (payments) — Dashboard → Developers → API keys.
# Publishable key is safe in the browser; secret key is SERVER-ONLY (never
# prefix it with NEXT_PUBLIC_, never commit a real value).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR-PUBLISHABLE-KEY
STRIPE_SECRET_KEY=sk_test_YOUR-SECRET-KEY
# Webhook signing secret (Developers → Webhooks → your endpoint, or the
# `stripe listen` CLI). Used to verify Stripe calls to /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_YOUR-WEBHOOK-SECRET

# Admin dashboard at /admin (demand + catalogue monitoring).
# The admin account lives in Supabase (Authentication → Users → Add user).
# List the email(s) allowed to sign in here (comma-separated). Only these,
# authenticated against Supabase, can enter — needs the anon + service-role keys
# above. Optional ADMIN_SESSION_SECRET signs the session cookie (defaults to the
# service-role key if unset).
ADMIN_EMAILS=you@example.com
# ADMIN_SESSION_SECRET=any-long-random-string

# ---------------------------------------------------------------------------
# Noon import pipeline — IMPORT SCRIPTS ONLY (feature/noon-import branch).
# Not used by the storefront. See docs/NOON_IMPORT.md, and read its rights notice.
# The service-role key bypasses RLS — keep it server-side only, NEVER prefix it
# with NEXT_PUBLIC_, and never commit real values.
# ---------------------------------------------------------------------------
# FIRECRAWL_API_KEY=fc-...
# ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# TARGET_URL=https://www.noon.com/saudi-en/noon-premium-beauty/
# MAX_PRODUCTS=20
# ANTHROPIC_MODEL=claude-opus-4-8
# PRICE_CONVERSION_RATE=0.1
